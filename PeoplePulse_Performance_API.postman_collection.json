{
  "info": {
    "name": "PeoplePulse Performance Review API",
    "description": "Focused flow for creating a review cycle, submitting goals/KPIs, and checking manager/team review access.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "testAdminEmail", "value": "admin@peoplepulse.com" },
    { "key": "testAdminPassword", "value": "replace-with-test-admin-password" },
    { "key": "testEmployeeEmail", "value": "employee@example.com" },
    { "key": "testUserPassword", "value": "replace-with-test-user-password" },
    { "key": "managerToken", "value": "" },
    { "key": "employeeToken", "value": "" },
    { "key": "performanceCycleId", "value": "" },
    { "key": "performanceReviewId", "value": "" }
  ],
  "item": [
    {
      "name": "Login HR / Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('admin login succeeds', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) pm.collectionVariables.set('managerToken', pm.response.json().data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testAdminEmail}}\",\n  \"password\": \"{{testAdminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Login Employee",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('employee login succeeds', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) pm.collectionVariables.set('employeeToken', pm.response.json().data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmployeeEmail}}\",\n  \"password\": \"{{testUserPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Create Performance Cycle",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('cycle is created', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set('performanceCycleId', pm.response.json().data.cycle._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{managerToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"period\": \"Performance Test {{$guid}}\",\n  \"status\": \"open\"\n}"
        },
        "url": "{{baseUrl}}/performance/cycles"
      }
    },
    {
      "name": "Submit Self-Review",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('self-review is submitted', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "  const review = pm.response.json().data.review;",
              "  pm.expect(review.rating).to.be.within(1, 5);",
              "  pm.collectionVariables.set('performanceReviewId', review._id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{employeeToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"selfReview\": \"Delivered planned work and supported the team.\",\n  \"rating\": 4,\n  \"goals\": [{\n    \"title\": \"Improve response time\",\n    \"status\": \"in_progress\",\n    \"kpis\": [{ \"name\": \"Average response time\", \"target\": 4, \"actual\": 5, \"unit\": \"hours\", \"weight\": 50 }]\n  }]\n}"
        },
        "url": "{{baseUrl}}/performance/cycles/{{performanceCycleId}}/reviews"
      }
    }
  ,
    {
      "name": "List Manager Team Reviews",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
        "url": "{{baseUrl}}/performance/team/reviews?page=1&limit=20"
      }
    },
    {
      "name": "Get Review (Manager/HR/Owner Only)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
        "url": "{{baseUrl}}/performance/reviews/{{performanceReviewId}}"
      }
    },
    {
      "name": "Submit Manager Review and Rating",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('manager review is submitted', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const review = pm.response.json().data.review;",
              "  pm.expect(review.managerReview).to.not.be.empty;",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{managerToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"managerReview\": \"Great performance and project execution.\",\n  \"rating\": 5\n}"
        },
        "url": "{{baseUrl}}/performance/reviews/{{performanceReviewId}}/manager-review"
      }
    }
  ]
}
