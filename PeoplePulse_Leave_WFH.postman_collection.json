    {
      "name": "Payroll - Generate Payslips",
      "description": "Requires all active employees to have a valid salary assignment. Existing payslips for the month are skipped and reported in skippedCount and skippedEmployees.",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('generation reports inserted and skipped payslips', function () {",
              "  pm.expect([200, 201]).to.include(pm.response.code);",
              "  const data = pm.response.json().data;",
              "  pm.expect(data.count).to.be.a('number');",
              "  pm.expect(data.skippedCount).to.be.a('number');",
              "  pm.expect(data.skippedEmployees).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"month\": \"2099-11\"\n}"
        },
        "url": "{{baseUrl}}/payroll/generate"
      }
    },
    {
      "name": "Payroll - Repeat Generation Shows Skips",
      "description": "Run after Payroll - Generate Payslips using the same month.",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('repeat payroll generation skips previously created employees', function () {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json().data;",
              "  pm.expect(data.count).to.eql(0);",
              "  pm.expect(data.skippedCount).to.be.a('number');",
              "  pm.expect(data.skippedEmployees).to.be.an('array');",
              "});"
            ]
          }
        }
