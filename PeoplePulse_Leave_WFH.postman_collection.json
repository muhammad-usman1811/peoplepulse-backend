{
  "info": {
    "name": "PeoplePulse Leave and WFH API",
    "description": "Leave, WFH, reports, and payroll API examples including notification outcomes and report filters.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "testAdminEmail",
      "value": "admin@peoplepulse.com"
    },
    {
      "key": "testAdminPassword",
      "value": "replace-with-test-admin-password"
    },
    {
      "key": "testEmployeeEmail",
      "value": "employee@example.com"
    },
    {
      "key": "testUserPassword",
      "value": "replace-with-test-user-password"
    },
    {
      "key": "employeeToken",
      "value": ""
    },
    {
      "key": "managerToken",
      "value": ""
    },
    {
      "key": "createdEmployeeId",
      "value": ""
    },
    {
      "key": "leaveRequestId",
      "value": ""
    },
    {
      "key": "rejectedLeaveRequestId",
      "value": ""
    },
    {
      "key": "wfhRequestId",
      "value": ""
    },
    {
      "key": "approvedWfhRequestId",
      "value": ""
    },
    {
      "key": "performanceCycleId",
      "value": ""
    },
    {
      "key": "performanceReviewId",
      "value": ""
    },
    {
      "key": "documentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login Employee",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set('employeeToken', pm.response.json().data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmployeeEmail}}\",\n  \"password\": \"{{testUserPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Login Manager",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set('managerToken', pm.response.json().data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testAdminEmail}}\",\n  \"password\": \"{{testAdminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "HR Create Employee",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('employee is created', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('createdEmployeeId', pm.response.json().data.employee.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Audit Employee\",\n  \"email\": \"postman.audit.{{$timestamp}}@peoplepulse.com\",\n  \"password\": \"Password@123\"\n}"
        },
        "url": "{{baseUrl}}/employees"
      }
    },
    {
      "name": "Verify Employee Creation Audit",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('employee creation is audited', function () {",
              "  const log = pm.response.json().data.logs[0];",
              "  pm.expect(log.action).to.eql('CREATE');",
              "  pm.expect(log.resource).to.eql('Employee');",
              "  pm.expect(log.resourceId).to.eql(pm.collectionVariables.get('createdEmployeeId'));",
              "  pm.expect(log.createdAt).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          }
        ],
        "url": "{{baseUrl}}/audit-log?resource=Employee&action=CREATE&resourceId={{createdEmployeeId}}"
      }
    },
    {
      "name": "Employee Apply Leave",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set('leaveRequestId', pm.response.json().data.request.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{employeeToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"annual\",\n  \"startDate\": \"2026-10-05\",\n  \"endDate\": \"2026-10-07\",\n  \"reason\": \"Family trip\"\n}"
        },
        "url": "{{baseUrl}}/leave-requests"
      }
    },
    {
      "name": "Employee List My Leave",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{employeeToken}}"
          }
        ],
        "url": "{{baseUrl}}/leave-requests/my"
      }
    },
    {
      "name": "Manager Approve Leave",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"note\": \"Approved\"\n}"
        },
        "url": "{{baseUrl}}/leave-requests/{{leaveRequestId}}/approve"
      }
    },
    {
      "name": "Verify Leave Approval Audit",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('approval is recorded in the audit log', function () {",
              "  const logs = pm.response.json().data.logs;",
              "  pm.expect(logs.some((log) => log.action === 'APPROVE' && log.resource === 'LeaveRequest' && log.resourceId === pm.collectionVariables.get('leaveRequestId'))).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          }
        ],
        "url": "{{baseUrl}}/audit-log?resource=LeaveRequest&action=APPROVE&resourceId={{leaveRequestId}}"
      }
    },
    {
      "name": "Employee Apply Leave for Rejection",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set('rejectedLeaveRequestId', pm.response.json().data.request.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{employeeToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"sick\",\n  \"startDate\": \"2026-11-05\",\n  \"endDate\": \"2026-11-05\",\n  \"reason\": \"Postman rejection audit check\"\n}"
        },
        "url": "{{baseUrl}}/leave-requests"
      }
    },
    {
      "name": "Manager Reject Leave",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"note\": \"Rejected for audit verification\"\n}"
        },
        "url": "{{baseUrl}}/leave-requests/{{rejectedLeaveRequestId}}/reject"
      }
    },
    {
      "name": "Verify Leave Rejection Audit",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('leave rejection is audited', function () {",
              "  const log = pm.response.json().data.logs[0];",
              "  pm.expect(log.action).to.eql('REJECT');",
              "  pm.expect(log.resource).to.eql('LeaveRequest');",
              "  pm.expect(log.resourceId).to.eql(pm.collectionVariables.get('rejectedLeaveRequestId'));",
              "  pm.expect(log.createdAt).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          }
        ],
        "url": "{{baseUrl}}/audit-log?resource=LeaveRequest&action=REJECT&resourceId={{rejectedLeaveRequestId}}"
      }
    },
