      "name": "Reports - Leave Summary",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('leave summary returns overlap-filtered counts and its range', function () {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json().data;",
              "  pm.expect(data.total).to.be.a('number');",
              "  pm.expect(data.byStatus).to.be.an('object');",
              "  pm.expect(data.byType).to.be.an('object');",
