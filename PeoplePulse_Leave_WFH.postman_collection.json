    {
      "name": "Reports - Attendance Summary",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('attendance summary returns counts and effective date range', function () {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json().data;",
              "  pm.expect(data.total).to.be.a('number');",
              "  pm.expect(data.byStatus).to.be.an('object');",
              "  pm.expect(data.from).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
              "  pm.expect(data.to).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          }
        ],
        "url": "{{baseUrl}}/reports/attendance-summary"
      }
    },
    {
      "name": "Reports - Attendance Grouped by Employee",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('attendance can be grouped by employee', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data.groupBy).to.eql('employee'); pm.expect(pm.response.json().data.groups).to.be.an('array'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          }
