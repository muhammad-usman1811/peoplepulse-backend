    {
      "name": "Documents - Upload My Document",
      "description": "Select a PDF, JPEG, or PNG file no larger than 5 MB. Uses the authenticated employee token.",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('document upload succeeds', function () { pm.response.to.have.status(201); });",
