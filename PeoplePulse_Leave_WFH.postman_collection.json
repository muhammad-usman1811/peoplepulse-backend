    {
      "name": "Documents - List My Documents",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('uploaded document is listed for its owner', function () {",
              "  pm.response.to.have.status(200);",
              "  const docs = pm.response.json().data.documents;",
              "  pm.expect(docs).to.be.an('array');",
              "  pm.expect(docs.some(function (doc) { return doc._id === pm.collectionVariables.get('documentId'); })).to.eql(true);",
              "  pm.expect(docs[0]).to.not.have.property('fileData');",
