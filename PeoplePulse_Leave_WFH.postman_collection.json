      "name": "Reports - Attendance Grouped by Department",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('attendance can be grouped by department', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data.groupBy).to.eql('department'); pm.expect(pm.response.json().data.groups).to.be.an('array'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          }
