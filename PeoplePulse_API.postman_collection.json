{
  "info": {
    "name": "PeoplePulse HRMS API",
    "description": "Collection of authentication and profile endpoints for Flutter & React clients",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "2. Login (Super Admin)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.success && jsonData.data && jsonData.data.token) {",
              "    pm.collectionVariables.set('token', jsonData.data.token);",
              "    console.log('Saved token to collection variable: ' + jsonData.data.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@peoplepulse.com\",\n  \"password\": \"Password@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "3. Get My Profile (Protected)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "me"]
        }
      }
    },
    {
      "name": "4. Get Complete Profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/profile",
          "host": ["{{baseUrl}}"],
          "path": ["profile"]
        }
      }
    },
    {
      "name": "5. Update Profile",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ayesha Khan\",\n  \"phoneNumber\": \"+92 300 1234567\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/profile",
          "host": ["{{baseUrl}}"],
          "path": ["profile"]
        }
      }
    },
    {
      "name": "6. Change Password",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"Password@123\",\n  \"newPassword\": \"NewPassword@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/profile/password",
          "host": ["{{baseUrl}}"],
          "path": ["profile", "password"]
        }
      }
    },
    {
      "name": "7. Get Notification Preferences",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/profile/notifications",
          "host": ["{{baseUrl}}"],
          "path": ["profile", "notifications"]
        }
      }
    },
    {
      "name": "8. Update Notification Preferences",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": true,\n  \"push\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/profile/notifications",
          "host": ["{{baseUrl}}"],
          "path": ["profile", "notifications"]
        }
      }
    },
    {
      "name": "9. Forgot Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@peoplepulse.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/forgot-password",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "forgot-password"]
        }
      }
    },
    {
      "name": "10. Reset Password",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"NewPassword@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/reset-password/REPLACE_WITH_RESET_TOKEN",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "reset-password", "REPLACE_WITH_RESET_TOKEN"]
        }
      }
    },
    {
      "name": "11. Register New User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@peoplepulse.com\",\n  \"password\": \"Password@123\",\n  \"department\": \"Engineering\",\n  \"designation\": \"Software Engineer\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "12. List Departments",
      "description": "Supports simple text filtering. Example: {{baseUrl}}/org/departments?name=Product or ?location=Lahore",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
        "url": {
          "raw": "{{baseUrl}}/org/departments?location=Lahore",
          "host": ["{{baseUrl}}"],
          "path": ["org", "departments"],
          "query": [{ "key": "location", "value": "Lahore" }]
        }
      }
    },
    {
      "name": "13. Create Department",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Product Design\"\n}" },
        "url": { "raw": "{{baseUrl}}/org/departments", "host": ["{{baseUrl}}"], "path": ["org", "departments"] }
      }
    },
    {
      "name": "14. List Designations",
      "description": "Supports simple text filtering. Example: {{baseUrl}}/org/designations?name=Designer or ?location=Lahore",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
        "url": { "raw": "{{baseUrl}}/org/designations?name=Designer", "host": ["{{baseUrl}}"], "path": ["org", "designations"], "query": [{ "key": "name", "value": "Designer" }] }
      }
    },
    {
      "name": "15. Create Designation",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"UX/UI Designer\"\n}" },
        "url": { "raw": "{{baseUrl}}/org/designations", "host": ["{{baseUrl}}"], "path": ["org", "designations"] }
      }
    },
    {
      "name": "16. List Locations",
      "description": "Supports simple text filtering. Example: {{baseUrl}}/org/locations?location=Lahore or ?name=Office",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
        "url": { "raw": "{{baseUrl}}/org/locations?location=Lahore", "host": ["{{baseUrl}}"], "path": ["org", "locations"], "query": [{ "key": "location", "value": "Lahore" }] }
      }
    },
    {
      "name": "17. Create Location",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Islamabad Office\"\n}" },
        "url": { "raw": "{{baseUrl}}/org/locations", "host": ["{{baseUrl}}"], "path": ["org", "locations"] }
      }
    },
    {
      "name": "18. Clock In",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
        ],
        "url": { "raw": "{{baseUrl}}/attendance/clock-in", "host": ["{{baseUrl}}"], "path": ["attendance", "clock-in"] }
      }
    },
    {
      "name": "19. Clock Out",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
        ],
        "url": { "raw": "{{baseUrl}}/attendance/clock-out", "host": ["{{baseUrl}}"], "path": ["attendance", "clock-out"] }
      }
    },
    {
      "name": "20. My Attendance History",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
        ],
        "url": {
          "raw": "{{baseUrl}}/attendance/me?from=2026-09-01&to=2026-09-30&limit=30",
          "host": ["{{baseUrl}}"],
          "path": ["attendance", "me"],
          "query": [
            { "key": "from", "value": "2026-09-01" },
            { "key": "to", "value": "2026-09-30" },
            { "key": "limit", "value": "30" }
          ]
        }
      }
    },
    {
      "name": "18. List Employees",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
        "url": {
          "raw": "{{baseUrl}}/employees?page=1&limit=10&search=&department=Engineering&location=Head%20Office&status=active",
          "host": ["{{baseUrl}}"],
          "path": ["employees"],
          "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }, { "key": "search", "value": "" }, { "key": "department", "value": "Engineering" }, { "key": "location", "value": "Head Office" }, { "key": "status", "value": "active" }]
        }
      }
    },
    {
      "name": "19. Get Employee",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
        "url": { "raw": "{{baseUrl}}/employees/REPLACE_WITH_EMPLOYEE_ID", "host": ["{{baseUrl}}"], "path": ["employees", "REPLACE_WITH_EMPLOYEE_ID"] }
      }
    },
    {
      "name": "20. Create Employee",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane.doe@peoplepulse.com\",\n  \"password\": \"Password@123\",\n  \"department\": \"Engineering\",\n  \"designation\": \"Software Engineer\",\n  \"location\": \"Head Office\",\n  \"status\": \"active\"\n}" },
        "url": { "raw": "{{baseUrl}}/employees", "host": ["{{baseUrl}}"], "path": ["employees"] }
      }
    },
    {
      "name": "21. Update Employee",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"department\": \"Product Engineering\",\n  \"designation\": \"Senior Software Engineer\",\n  \"location\": \"Remote\",\n  \"status\": \"on-leave\"\n}" },
        "url": { "raw": "{{baseUrl}}/employees/REPLACE_WITH_EMPLOYEE_ID", "host": ["{{baseUrl}}"], "path": ["employees", "REPLACE_WITH_EMPLOYEE_ID"] }
      }
    },
    {
      "name": "22. Deactivate Employee",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
        "url": { "raw": "{{baseUrl}}/employees/REPLACE_WITH_EMPLOYEE_ID", "host": ["{{baseUrl}}"], "path": ["employees", "REPLACE_WITH_EMPLOYEE_ID"] }
      }
    }
  ]
}
