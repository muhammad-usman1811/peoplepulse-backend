{
  "name": "peoplepulse-backend",
  "version": "1.0.0",
  "description": "Cross-platform REST API for PeoplePulse HRMS (Flutter & React)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed.js",
    "backfill:search-index": "node src/scripts/backfillNameSearchTokens.js",
    "backfill:department-locations": "node src/scripts/backfillDepartmentLocations.js",
    "test:leave-wfh": "cross-env NODE_ENV=test node test-leave-wfh.js",
    "test": "npm run test:unit",
    "test:unit": "node --test test-auth-security.js test-employee-validation.js test-performance-permissions.js test-request-controller.js test-payroll-controller.js test-reports-controller.js",
    "test:request": "node --test test-request-controller.js",
    "test:api": "cross-env NODE_ENV=test node src/test_api.js",
    "test:auth-reset:api": "cross-env NODE_ENV=test node test-auth-reset-api.js",
    "test:user-fixture": "cross-env NODE_ENV=test node create-test-user.js",
    "test:employee": "cross-env NODE_ENV=test node test-employee-crud.js",
    
    "test:employee-validation": "node --test test-employee-validation.js",
    "test:audit": "cross-env NODE_ENV=test node test-audit.js",
    "test:performance": "node --test test-performance-permissions.js",
    "test:performance:api": "cross-env NODE_ENV=test node test-performance-api.js",
    "test:email:smtp": "node test-live-email-smtp.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "hrms",
    "flutter",
    "react",
    "jwt",
    "bcrypt"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.10",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.2"
  }
}
