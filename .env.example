PORT=5000
NODE_ENV=development
APP_TIMEZONE=Asia/Karachi
MONGO_URI=mongodb://127.0.0.1:27017/peoplepulse
MONGO_TEST_URI=mongodb://127.0.0.1:27017/peoplepulse_test
TEST_ADMIN_EMAIL=admin@peoplepulse.com
# Set this to the same value as SEED_PASSWORD for the disposable test database.
TEST_ADMIN_PASSWORD=replace_with_test_admin_password
TEST_USER_PASSWORD=replace_with_test_user_password
# Use a long random string in every real environment - do not reuse this example value
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d
# 32-byte (64 hex characters) key for AES-256 data-at-rest encryption - generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_64_hex_characters
SEED_PASSWORD=replace_with_a_development_only_seed_password
CLIENT_URL=http://localhost:3000,http://localhost:5173
# Base URL used to build the password-reset link in emails
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5000
SEARCH_INDEX_KEY=replace_with_a_long_random_secret
ALLOW_DESTRUCTIVE_SEED=false
# MongoDB-backed document upload quotas (bytes); lower per-file maximum is 4 MiB.
DOCUMENT_USER_STORAGE_QUOTA_BYTES=52428800
DOCUMENT_TOTAL_STORAGE_QUOTA_BYTES=1073741824
# Optional: Gmail account + App Password used to email password-reset links.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=your_google_app_password
